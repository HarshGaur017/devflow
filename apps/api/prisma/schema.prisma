generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())

  githubId     String   @unique
  username     String

  name         String?
  email        String?
  avatarUrl    String?

  accessToken  String?
  refreshToken String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}